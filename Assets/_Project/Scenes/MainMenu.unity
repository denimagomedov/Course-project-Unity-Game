  m_text: "\u0412\u044B \u0443\u0441\u043D\u0443\u043B\u0438 \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435
    \u0412\u044B\u0441\u0448\u0435\u0439 \u0448\u043A\u043E\u043B\u044B \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438,
    \u043D\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C \u0443\u0436\u0435
    \u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u0432 \u0442\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438,
    \u0433\u0434\u0435 \u0437\u0430\u0441\u044B\u043F\u0430\u043B\u0438.\n\n\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C
    \u043E\u0442\u0441\u044E\u0434\u0430 \u0438 \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435
    \u0441\u0432\u043E\u0438 \u0432\u0435\u0449\u0438.\n\n\u041D\u043E \u0431\u0443\u0434\u044C\u0442\u0435
    \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B \u2014 \u0445\u043E\u0434\u044F\u0442
    \u0441\u043B\u0443\u0445\u0438, \u0447\u0442\u043E \u0432 \u044D\u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
    \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0432\u0435\u0449\u0438.\n\n\u0423\u0434\u0430\u0447\u0438!"
